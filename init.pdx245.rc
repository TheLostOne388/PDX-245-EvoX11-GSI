# PDX245 device-specific init
# Runs property fixup script under phhsu_daemon SELinux context.
# This is needed because SELinux enforcing mode blocks certain property
# namespaces (ro.vendor.*, persist.bluetooth.*) from being loaded via
# build.prop when set from the system/product partition.

# --- Early telephony property (before package manager scans) ---
# ims.apk overlay requires ro.boot.vendor.qspa.modem=enabled to load.
# Must be set before zygote/system_server starts scanning packages.
on post-fs-data
    exec u:r:phhsu_daemon:s0 root -- /system/bin/resetprop_phh ro.boot.vendor.qspa.modem enabled

# --- Main fixup script (runs after boot completes) ---
service pdx245_fixup /system/bin/pdx245-fixup-props.sh
    class main
    user root
    group root
    oneshot
    disabled
    seclabel u:r:phhsu_daemon:s0

on property:sys.boot_completed=1
    start pdx245_fixup
