<?xml version="1.0" encoding="utf-8"?>
<!--
    Sony Xperia 1 VI (PDX245) Display Configuration Overlay
    
    ONLY enables auto-brightness boolean - brightness curves come from
    vendor displayconfig (/vendor/etc/displayconfig/display_id_131.xml)
-->
<resources>
    <!-- Enable automatic/adaptive brightness -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Auto-brightness curve (Lux -> Brightness 0-255) -->
    <!-- Essential for GSI to map light sensor values to screen brightness -->
    <integer-array name="config_autoBrightnessLevels">
        <item>5</item>
        <item>20</item>
        <item>100</item>
        <item>500</item>
        <item>1000</item>
        <item>2500</item>
        <item>5000</item>
    </integer-array>

    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>2</item>   <!-- 0-5 Lux -->
        <item>8</item>   <!-- 5-20 Lux -->
        <item>25</item>  <!-- 20-100 Lux -->
        <item>70</item>  <!-- 100-500 Lux -->
        <item>110</item> <!-- 500-1000 Lux -->
        <item>150</item> <!-- 1000-2500 Lux -->
        <item>210</item> <!-- 2500-5000 Lux -->
        <item>255</item> <!-- 5000+ Lux -->
    </integer-array>

    <!-- AOD (Doze) Brightness Configuration -->
    <!-- Screen brightness for AOD/doze mode
         Sony display minimum: 0.0013 = 2.0 nits (from vendor displayconfig)
         The hardware cannot go lower than 2 nits -->
    <integer name="config_screenBrightnessDoze">1</integer>
    <!-- Float version - Using Sony's minimum value 0.0013 = 2.0 nits -->
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.0013</item>
    
    <!-- AOD availability from Sony vendor overlay -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <bool name="config_dozeAlwaysOnEnabled">true</bool>







    <!-- Override minimum brightness (framework default is 10/255=0.039 = 53 nits) -->
    <!-- Lowering to 1 (0.0039 / ~6 nits). This is safe (> raw min 0.0013) and much dimmer than 53 nits. -->
    <integer name="config_screenBrightnessSettingMinimum">1</integer>
    <!-- Removed float override to avoid validation crashes. Integer 1 is sufficient. -->
</resources>
